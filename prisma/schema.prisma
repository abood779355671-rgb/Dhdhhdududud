generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
  }

  model User {
    id        String   @id @default(cuid())
    username  String   @unique
    password  String
    name      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    invitations Invitation[]
    templates   Template[]
  }

  model Template {
    id          String   @id @default(cuid())
    name        String
    description String?
    category    String
    isBuiltIn   Boolean  @default(false)
    designKey   String?
    colorKey    String?
    fontKey     String?
    data        String
    thumbnail   String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  }

  model Invitation {
    id               String    @id @default(cuid())
    slug             String    @unique
    title            String
    brideName        String?
    groomName        String?
    weddingDate      DateTime?
    venueName        String?
    venueAddress     String?
    venueLat         Float?
    venueLng         Float?
    password         String?
    expiresAt        DateTime?
    views            Int       @default(0)
    isPublished      Boolean   @default(false)
    data             String
    templateSnapshot String?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    rsvps    Rsvp[]
    versions InvitationVersion[]
    events   WeddingEvent[]
  }

  model InvitationVersion {
    id           String   @id @default(cuid())
    invitationId String
    data         String
    note         String?
    createdAt    DateTime @default(now())
    invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  }

  model WeddingEvent {
    id           String   @id @default(cuid())
    invitationId String
    title        String
    description  String?
    startTime    DateTime
    endTime      DateTime?
    location     String?
    order        Int      @default(0)
    createdAt    DateTime @default(now())
    invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  }

  model Rsvp {
    id           String   @id @default(cuid())
    invitationId String
    guestName    String
    phone        String?
    attending    Boolean
    guestsCount  Int      @default(0)
    note         String?
    isRead       Boolean  @default(false)
    createdAt    DateTime @default(now())
    invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  }
  